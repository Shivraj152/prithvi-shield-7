{
  "version": 2,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS, PUT, DELETE" },
        { "key": "Access-Control-Allow-Headers", "value": "X-Requested-With, Content-Type, Authorization, Access-Token" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/ml/:path*",
      "destination": "https://prithvi-ml.onrender.com/:path*"
    }
  ]
}

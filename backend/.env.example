# =========================================================================
# PRITHVI-SHIELD BACKEND (EXPRESS & VERCEL SERVERLESS) ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to `backend/.env` or add these keys to Vercel Environment Variables
# =========================================================================

PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_prithvi_shield_key_123

# Pushbullet Access Token (Obtain from https://www.pushbullet.com/#settings/account)
PUSHBULLET_TOKEN=o.your_pushbullet_access_token_here

# Twilio Cellular SMS Gateway Credentials (Obtain from https://www.twilio.com/console)
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1your_twilio_sender_phone_number_here

# Google Gemini AI API Key (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

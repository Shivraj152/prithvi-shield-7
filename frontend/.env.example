# =========================================================================
# PRITHVI-SHIELD FRONTEND (VITE CLIENT) ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to `frontend/.env` or add these keys to Vercel Environment Variables
# NOTE: All keys exposed to browser React code MUST start with `VITE_`
# =========================================================================

# Pushbullet Access Token (Obtain from https://www.pushbullet.com/#settings/account)
VITE_PUSHBULLET_TOKEN=o.your_pushbullet_access_token_here

# Twilio Direct Cellular SMS Gateway Credentials (Optional)
VITE_TWILIO_SID=ACyour_twilio_account_sid_here
VITE_TWILIO_TOKEN=your_twilio_auth_token_here
VITE_TWILIO_PHONE=+1your_twilio_sender_phone_number_here

# Mapbox Access Token (Optional - for vector terrain map drawing)
VITE_MAPBOX_ACCESS_TOKEN=pk.placeholder_mapbox_token

# Test Mobile Phone Number
VITE_TEST_PHONE=+919876543210
